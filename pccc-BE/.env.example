PORT=4000
# PDF upload limit in bytes (1024 to 5242880).
LEGAL_DOCUMENT_MAX_BYTES=5242880
# Inspection record/evidence upload limit in bytes (1024 to 10485760).
INSPECTION_DOCUMENT_MAX_BYTES=5242880
# Facility profile attachment limit in bytes (1024 to 10485760).
FACILITY_ATTACHMENT_MAX_BYTES=10485760
# Optional private directory outside pccc-FE/public (defaults to pccc-BE/src/private).
# FACILITY_ATTACHMENT_DIR=C:/private/pccc/facility-attachments
HOST=127.0.0.1
# Database. Two options:
# - Embedded PostgreSQL (PGlite) in a local folder: no database server needed (default).
# - A PostgreSQL server URL, e.g. Neon/Supabase in production or a local server:
#   postgresql://user:password@host:5432/pccc?sslmode=require
#   URL-encode special characters in the username and password.
DATABASE_URL=./data/pccc-pg
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
# Public demo password for team testing; production demo seed is disabled.
DEMO_PASSWORD=PcccDemo@2026
