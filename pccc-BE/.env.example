PORT=4000
# PDF upload limit in bytes (1024 to 5242880).
LEGAL_DOCUMENT_MAX_BYTES=5242880
# Inspection record/evidence upload limit in bytes (1024 to 10485760).
INSPECTION_DOCUMENT_MAX_BYTES=5242880
# Facility profile attachment limit in bytes (1024 to 10485760).
FACILITY_ATTACHMENT_MAX_BYTES=10485760
# Optional private directory outside pccc-FE/public (defaults to pccc-BE/src/private).
# FACILITY_ATTACHMENT_DIR=C:/private/pccc/facility-attachments
HOST=127.0.0.1
DATABASE_PATH=./data/pccc.sqlite
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
# Public demo password for team testing; production demo seed is disabled.
DEMO_PASSWORD=PcccDemo@2026

# PostgreSQL connection settings (reserved for PostgreSQL integration).
# Replace these values with your PostgreSQL server credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=pccc
PGUSER=postgres
PGPASSWORD=change_me
# Local PostgreSQL: disable. Use require when your hosted provider requires SSL.
PGSSLMODE=disable
# Keep this URL in sync with the PG* values above.
# URL-encode special characters in the username and password in this URL.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/pccc?sslmode=disable
