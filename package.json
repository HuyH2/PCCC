{
  "name": "pccc",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống quản lý công tác PCCC & CNCH — monorepo gồm pccc-FE (Next.js) và pccc-BE (Node.js API)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:fe": "pnpm --filter pccc-fe dev",
    "dev:be": "pnpm --filter pccc-be dev",
    "build": "pnpm --filter pccc-fe build",
    "start:fe": "pnpm --filter pccc-fe start",
    "start:be": "pnpm --filter pccc-be start",
    "migrate": "pnpm --filter pccc-be migrate",
    "seed": "pnpm --filter pccc-be seed",
    "lint": "eslint .",
    "typecheck": "pnpm --filter pccc-fe typecheck",
    "test": "pnpm --filter pccc-be test",
    "check": "pnpm --filter pccc-be check",
    "test:integration": "node --test tests/auth-integration.test.mjs",
    "format:check": "node scripts/format-auth.mjs",
    "format:auth": "node scripts/format-auth.mjs --write"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.34.7"
}
